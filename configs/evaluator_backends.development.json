{
  "schema_version": 1,
  "repo_root": "..",
  "backends": {
    "receiver_observer": {
      "enabled": true,
      "mock": false,
      "timeout_seconds": 0,
      "command": [
        "{python}",
        "{repo_root}/experiments/evaluator_adapters/receiver_observer_adapter.py",
        "--input", "{input_manifest}",
        "--output", "{output_evidence}",
        "--work-dir", "{work_dir}",
        "--repo-root", "{repo_root}",
        "{resume_flag}"
      ]
    },
    "source_mechanics": {
      "enabled": true,
      "mock": false,
      "timeout_seconds": 0,
      "command": [
        "{python}",
        "{repo_root}/experiments/evaluator_adapters/source_mechanics_adapter.py",
        "--input", "{input_manifest}",
        "--output", "{output_evidence}",
        "--work-dir", "{work_dir}",
        "--repo-root", "{repo_root}",
        "--qwen-checkpoint", "{repo_root}/checkpoints/qwen3-vl",
        "{resume_flag}"
      ]
    },
    "causality": {
      "enabled": true,
      "mock": false,
      "timeout_seconds": 0,
      "command": [
        "{python}",
        "{repo_root}/experiments/evaluator_adapters/causality_adapter.py",
        "--input", "{input_manifest}",
        "--output", "{output_evidence}",
        "--work-dir", "{work_dir}",
        "--repo-root", "{repo_root}",
        "{resume_flag}"
      ]
    },
    "rt60": {
      "enabled": true,
      "mock": false,
      "timeout_seconds": 0,
      "command": [
        "{python}",
        "{repo_root}/experiments/evaluator_adapters/rt60_adapter.py",
        "--input", "{input_manifest}",
        "--output", "{output_evidence}",
        "--work-dir", "{work_dir}",
        "--repo-root", "{repo_root}",
        "--base-model", "{repo_root}/checkpoints/qwen3-vl",
        "--checkpoint", "{repo_root}/checkpoints/acoustitrace-rt60",
        "{resume_flag}"
      ]
    },
    "log_attack_time": {
      "enabled": true,
      "mock": false,
      "timeout_seconds": 0,
      "command": [
        "{python}",
        "{repo_root}/experiments/evaluator_adapters/log_attack_time_adapter.py",
        "--input", "{input_manifest}",
        "--output", "{output_evidence}",
        "--work-dir", "{work_dir}",
        "--repo-root", "{repo_root}",
        "{resume_flag}"
      ]
    }
  }
}
